<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram Login Window</title>
</head>
<body>
    <h1>Instagram</h1>
    <h3>Welcome : @<%= username %> </h3>
    <button>SignIn</button>
    <button>Follow</button>

    <h3> Followers: Account that follow you</h3>
    <ul>
        <% for(let name of followers){ %>
            <li> <%=  name %> </li>
            <% } %>
        
    </ul>
</body>
</html>